    "# smote undersampler ve unbalanced olayı burda\n",
    "def make_safe_sheet_name(name, max_len=31):\n",
    "    name = re.sub(r'[\\\\/*?:\\[\\]]', '_', name)\n",
    "    return name[:max_len]\n",
